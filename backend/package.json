{
  "name": "cloudharbor-api",
  "version": "1.9.1",
  "description": "CloudHarbor API基於Cloudflare Workers和D1資料庫",
  "main": "unified-entry.js",
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:parallel": "node --test",
    "dev": "wrangler dev --local",
    "dev:scheduled": "wrangler dev --local --test-scheduled",
    "deploy": "wrangler publish",
    "deploy:spa": "wrangler deploy --config wrangler.spa.toml",
    "docker-dev": "cross-env PORT=8787 ENCRYPTION_SECRET=default-encryption-key DATA_DIR=./data SCHEDULED_TICK_CRON=\"*/1 * * * *\" tsx unified-entry.js",
    "docker-start": "cross-env PORT=8787 DATA_DIR=/data tsx unified-entry.js"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "d1",
    "api",
    "paste"
  ],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "dependencies": {
    "@aws-crypto/sha256-browser": "^5.2.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/lib-storage": "3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "@hono/node-server": "^2.1.6",
    "@huggingface/hub": "^2.17.10",
    "@smithy/util-retry": "^4.6.2",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.10.4",
    "fast-xml-parser": "^5.12.0",
    "file-type": "^21.3.4",
    "hono": "^4.13.16",
    "mime-types": "^3.0.1",
    "node-schedule": "^2.1.1",
    "tsx": "^4.23.15",
    "webdav": "^5.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/better-sqlite3": "^7.6.13",
    "cross-env": "^7.0.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  },
  "optionalDependencies": {
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "overrides": {
    "tar-fs": "^2.1.4",
    "minimatch": "^11.0.1"
  }
}
